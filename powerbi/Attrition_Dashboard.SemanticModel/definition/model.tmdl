model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Employees", "Dim_Department", "Dim_AgeGroup", "Dim_IncomeBand", "Dim_Tenure", "Satisfaction_Long", "Driver_Impact", "Action_Plan", "Cleaning_Log", "Quality_Flags", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Employees
ref table Dim_Department
ref table Dim_AgeGroup
ref table Dim_IncomeBand
ref table Dim_Tenure
ref table Satisfaction_Long
ref table Driver_Impact
ref table Action_Plan
ref table Cleaning_Log
ref table Quality_Flags
ref table _Measures
ref table 'Replacement Cost'
