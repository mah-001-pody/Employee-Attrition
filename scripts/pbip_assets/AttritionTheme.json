            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
