        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1A2233"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1A2233"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
